# ============================================
# Control Personal — Configuración
# ============================================
# Copia este archivo como .env y completa los valores

# --- Base de datos PostgreSQL (Render, Supabase, Neon, etc.) ---
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_bd"

# --- JWT ---
JWT_SECRET="cambia-esto-por-un-secreto-seguro"
JWT_EXPIRES=24h

# --- Servidor ---
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Seed (admin inicial — solo para npm run db:seed) ---
ADMIN_EMAILS=admin@ejemplo.com
ADMIN_PASSWORD=CambiaEstaPassword123!
ADMIN_NOMBRE=Administrador

# --- Logging ---
LOG_LEVEL=debug
