# Base de datos (usar URL de pooler de Supabase para Vercel)
# Pooler: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_bd"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-seguro"
JWT_EXPIRES=24h

# Servidor
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Seed (admin inicial — solo para npm run db:seed)
ADMIN_EMAILS=admin@ejemplo.com
ADMIN_PASSWORD=CambiaEstaPassword123!
ADMIN_NOMBRE=Administrador

# Google Drive
GOOGLE_DRIVE_CREDENTIALS="./credentials-drive.json"
GOOGLE_DRIVE_FOLDER_ID="root"
